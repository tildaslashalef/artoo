.{
    .name = .artoo,
    // Not artoo's version: Zig requires this field. `artoo --version` comes
    // from the Git release tags (build.zig, docs/RELEASING.md §1).
    .version = "0.0.0",
    // Regenerated for this fresh package identity (never copied from an
    // upstream project). See build.zig.zon docs.
    .fingerprint = 0xcfd60ada86cce2c2,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "README.md",
        "LICENSE",
        "src",
    },
}
