"================================================================"
"         Self-Contained & Minimal Vimrc for Servers
"================================================================"


"----------------------------------------------------------------"
" => General Settings
"----------------------------------------------------------------"
set history=500                     " Lines of history VIM remembers
set encoding=utf-8                  " Use UTF-8 canonical spelling
let mapleader = ","                 " Set the map leader key
filetype plugin indent on           " Enable filetype detection, plugins, and indentation
syntax enable                       " Enable syntax highlighting

set autoread                        " Reload file if changed externally
au FocusGained,BufEnter * silent! checktime


"----------------------------------------------------------------"
" => User Interface
"----------------------------------------------------------------"
set number                          " Show line numbers
set relativenumber                  " Show relative line numbers
set ruler                           " Always show cursor position
set showcmd                         " Show incomplete commands
set laststatus=2                    " Always show the status line
set cmdheight=1                     " Height of the command bar

set scrolloff=3                     " Keep 3 lines of context around the cursor
set sidescrolloff=5                 " Keep 5 columns of context

set splitbelow                      " New horizontal splits go below
set splitright                      " New vertical splits go to the right

set list                            " Show whitespace characters
set listchars=tab:>-,trail:.,extends:>,precedes:<,nbsp:+ " ASCII whitespace chars for compatibility

set showmatch                       " Briefly jump to matching bracket
set mat=2                           " How long to wait on matching bracket (tenths of a second)
set hid                             " A buffer becomes hidden when it is abandoned

" No annoying sound on errors
set noerrorbells
set novisualbell
set t_vb=


"----------------------------------------------------------------"
" => Search & Replace
"----------------------------------------------------------------"
set ignorecase                      " Ignore case when searching
set smartcase                       " Be smart about case when searching
set hlsearch                        " Highlight all search results
set incsearch                       " Show search results as you type

" Clear search highlighting with <leader><cr>
map <silent> <leader><cr> :noh<cr>


"----------------------------------------------------------------"
" => Text, Tabs, and Indentation
"----------------------------------------------------------------"
set expandtab                       " Use spaces instead of tabs
set smarttab                        " Be smart about tabs
set shiftwidth=4                    " Indentation size
set tabstop=4                       " Tab width
set softtabstop=4                   " Soft tab width
set autoindent                      " Enable auto-indenting
set smartindent                     " Enable smart-indenting

set wrap                            " Wrap long lines
set linebreak                       " Wrap lines at convenient places
set showbreak=↪\                    " Character to show for wrapped lines


"----------------------------------------------------------------"
" => Files, Backups & Undo
"----------------------------------------------------------------"
set nobackup                        " No backup files
set nowritebackup                   " No write backup files
set noswapfile                      " No swap files

if has('persistent_undo')
    set undofile                    " Enable persistent undo
    let undodir = expand('~/.vim/undodir')
    if !isdirectory(undodir)
      call mkdir(undodir, 'p')
    endif
    set undodir=~/.vim/undodir      " Set undo directory
endif


"----------------------------------------------------------------"
" => Key Mappings
"----------------------------------------------------------------"
" Save file with <leader>w or Ctrl+S
nmap <leader>w :w!<cr>
nnoremap <C-s> :w<cr>
inoremap <C-s> <Esc>:w<cr>a

" Sudo save with :W
command! W execute 'w !sudo tee % > /dev/null' <bar> edit!

" Quit with <leader>q (quit) and <leader>Q (force quit all)
nnoremap <leader>q :q<cr>
nnoremap <leader>Q :qa!<cr>

" Window navigation
map <C-j> <C-W>j
map <C-k> <C-W>k
map <C-h> <C-W>h
map <C-l> <C-W>l

" Move lines up/down with Alt+j/k
nmap <M-j> mz:m+<cr>`z
nmap <M-k> mz:m-2<cr>`z

" Toggle line numbers
nnoremap <leader>n :set number!<cr>
nnoremap <leader>rn :set relativenumber!<cr>

" Toggle spell check
map <leader>ss :setlocal spell!<cr>

" Edit/reload vimrc
nnoremap <leader>ev :edit $MYVIMRC<cr>
nnoremap <leader>sv :source $MYVIMRC<cr>

" Toggle paste mode
map <leader>pp :setlocal paste!<cr>

" Toggle file explorer with <leader>e
nnoremap <leader>e :Lexplore<CR>


"----------------------------------------------------------------"
" => Status Line
"----------------------------------------------------------------"
" Custom highlight groups for status line modes
hi StatusLineMode guifg=#1d2021 guibg=#b8bb26 gui=bold ctermfg=234 ctermbg=142
hi StatusLineModeInsert guifg=#1d2021 guibg=#83a598 gui=bold ctermfg=234 ctermbg=109
hi StatusLineModeVisual guifg=#1d2021 guibg=#fe8019 gui=bold ctermfg=234 ctermbg=208
hi StatusLineModeReplace guifg=#1d2021 guibg=#fb4934 gui=bold ctermfg=234 ctermbg=167
hi StatusLineGit guifg=#fabd2f guibg=#504945 gui=bold ctermfg=214 ctermbg=239

" Tell Vim to use a function to generate the entire statusline.
set statusline=%!MyStatusLine()


"----------------------------------------------------------------"
" => File Explorer (Netrw)
"----------------------------------------------------------------"
set path+=** " Allow searching in all subdirectories
set wildmenu " Enable command-line completion menu

" Basic Netrw settings for a better experience
let g:netrw_banner=0              " Disable the banner
let g:netrw_liststyle=3           " Use tree view
let g:netrw_altv=1                " Open splits to the right
let g:netrw_winsize=25            " Set explorer width to 25%


"----------------------------------------------------------------"
