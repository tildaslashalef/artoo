" Apply the Gruvbox color scheme
call GruvboxColors()

" Re-apply colors if they are ever reset
autocmd ColorScheme * call GruvboxColors()




"----------------------------------------------------------------"
" => Helper Functions
"----------------------------------------------------------------"
" Master function to build the entire statusline string.
function! MyStatusLine()
    " Part 1: Mode Indicator
    let l:mode_str = ''
    let l:current_mode = mode()
    if l:current_mode == 'n'
        let l:mode_str = '%#StatusLineMode# NORMAL '
    elseif l:current_mode == 'i'
        let l:mode_str = '%#StatusLineModeInsert# INSERT '
    elseif l:current_mode =~# 'v\|V\|\<C-v>'
        let l:mode_str = '%#StatusLineModeVisual# VISUAL '
    elseif l:current_mode == 'R'
        let l:mode_str = '%#StatusLineModeReplace# REPLACE '
    else
        let l:mode_str = '%#StatusLineNC# ' . toupper(l:current_mode) . ' '
    endif

    " Part 2: File Info
    let l:file_info = '%#StatusLineNC# %F %m%r'

    " Part 3: Git Branch
    let l:git_branch = '%#StatusLineGit#%{GitBranch()}'

    " Part 4: File Type & Position
    let l:position = '%#StatusLineNC# %Y %#StatusLine# %l:%c %p%%'

    " Assemble the full string with right-alignment ('%=') in the middle
    return l:mode_str . l:file_info . '%=' . l:git_branch . l:position
endfunction

" Get current git branch for statusline (no plugins required)
function! GitBranch()
    let branch = system("git rev-parse --abbrev-ref HEAD 2>/dev/null")
    if v:shell_error == 0
        return ' ' . substitute(branch, '\n$', '', '') . ' '
    endif
    return ''
endfunction

" Delete trailing white space on save for some filetypes
function! CleanExtraSpaces()
    let save_cursor = getpos(".")
    let old_query = getreg('/')
    silent! %s/\s\+$//e
    call setpos('.', save_cursor)
    call setreg('/', old_query)
endfun

if has("autocmd")
    autocmd BufWritePre *.txt,*.js,*.py,*.wiki,*.sh,*.coffee,*.vim,*.html,*.css,*.json,*.yaml,*.yml :call CleanExtraSpaces()
endif


"----------------------------------------------------------------"
" => Filetype Specific Settings
"----------------------------------------------------------------"
augroup FiletypeSettings
    autocmd!
    " Golang, Rust, Java, C, C++, Python get 4 spaces
    autocmd FileType go,rust,java,c,cpp,python setlocal expandtab shiftwidth=4 tabstop=4 softtabstop=4
    " Web development files get 2 spaces
    autocmd FileType javascript,typescript,html,css,scss,sass,yaml setlocal expandtab shiftwidth=2 tabstop=2 softtabstop=2
augroup END


"----------------------------------------------------------------"
" => Final Customizations
"----------------------------------------------------------------"
" Load local settings if the file exists (for machine-specific overrides)
if filereadable(expand("~/.vimrc.local"))
    source ~/.vimrc.local
endif
